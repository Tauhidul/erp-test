# Copy to .env (git-ignored). In CI, set these as secrets.
MUKUT_BASE_URL=https://mukut.test.example.com
# Trailing slash matters: endpoints are written without a leading slash.
MUKUT_API_URL=https://mukut.test.example.com/api/

# One test user per role. Role names match src/config/roles.ts.
MUKUT_SALES_REP_USER=
MUKUT_SALES_REP_PASSWORD=
MUKUT_BUYER_USER=
MUKUT_BUYER_PASSWORD=
MUKUT_WAREHOUSE_CLERK_USER=
MUKUT_WAREHOUSE_CLERK_PASSWORD=
MUKUT_ACCOUNTANT_USER=
MUKUT_ACCOUNTANT_PASSWORD=
MUKUT_FINANCE_MANAGER_USER=
MUKUT_FINANCE_MANAGER_PASSWORD=
MUKUT_ADMIN_USER=
MUKUT_ADMIN_PASSWORD=
